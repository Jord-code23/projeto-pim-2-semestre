-- Estrutura da tabela `funcionarios` (Barbeiros e Equipe)

DROP TABLE IF EXISTS `funcionarios`;
CREATE TABLE `funcionarios` (
  `id_funcionario` INT NOT NULL AUTO_INCREMENT,
  `nome` VARCHAR(100) NOT NULL,
  `cpf` CHAR(11) NOT NULL UNIQUE,
  `rg` VARCHAR(20) DEFAULT NULL,
  `especialidade` VARCHAR(100) DEFAULT NULL,
  `telefone` VARCHAR(20) DEFAULT NULL,
  `email` VARCHAR(120) UNIQUE,
  `cargo` VARCHAR(30) NOT NULL CHECK (cargo IN ('BARBEIRO', 'RECEPCIONISTA', 'GERENTE', 'AUXILIAR')),
  `comissao_percentual` DECIMAL(5,2) NOT NULL DEFAULT 0.00 CHECK (comissao_percentual BETWEEN 0 AND 100),
  `salario_base` DECIMAL(10,2) NOT NULL DEFAULT 0.00 CHECK (salario_base >= 0),
  `data_admissao` DATE NOT NULL,
  `data_demissao` DATE DEFAULT NULL,
  `status` ENUM('ATIVO','INATIVO') DEFAULT 'ATIVO',
  `criado_em` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `atualizado_em` TIMESTAMP NULL DEFAULT NULL ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id_funcionario`)
) ENGINE=InnoDB AUTO_INCREMENT=3 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

